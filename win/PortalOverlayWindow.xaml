<Window x:Class="MacBridgeUI.PortalOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MacBridgeUI"
        Title="OmniFlow Edge Shelf"
        Width="16" Height="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop">
    <Grid Background="#01000000">
        <!-- Mode 1: Invisible Screen-Edge Portal Hover + Persistent Shelf Dock -->
        <Grid x:Name="EdgeWallRoot" Visibility="Visible" Background="#01000000">
            <Canvas x:Name="WallCanvas" Background="#01000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False"/>

            <StackPanel Margin="6" VerticalAlignment="Center">
                <!-- Hover / Active Transfer Capsule -->
                <Border x:Name="WallStatusPill" Visibility="Collapsed" Background="#F2141820" BorderBrush="#48FFFFFF" BorderThickness="1.2"
                        CornerRadius="12" Padding="13,9" Margin="0,0,0,6">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="WallStatusPillScale" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="WallStatusPillTranslate" X="0" Y="0"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <StackPanel>
                        <TextBlock x:Name="WallTitleText" Text="放到传输架" Foreground="#F2F2F7" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="WallSubText" Text="松手开始传输 · 移开取消" Foreground="#B8B8BE" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        <StackPanel x:Name="WallActionButtons" Orientation="Horizontal" Margin="0,7,0,0" Visibility="Collapsed">
                            <Button Content="{Binding [OverlayOpenDir], Source={x:Static local:AppLoc.Shared}}" Click="OpenReceived_Click" Background="#28B955" Foreground="White" BorderThickness="0" Padding="9,3" FontSize="10.5" Margin="0,0,6,0" Cursor="Hand"/>
                            <Button Content="×" Click="Dismiss_Click" Background="#2C3E32" Foreground="White" BorderThickness="0" Padding="8,3" FontSize="10.5" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Persistent Transfer & Pickup Shelf Cards -->
                <Border x:Name="PersistentShelfDock" Visibility="Collapsed" Background="#F2181A1F" BorderBrush="#38FFFFFF" BorderThickness="1"
                        CornerRadius="12" Padding="10">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="PersistentShelfDockScale" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="PersistentShelfDockTranslate" X="0" Y="0"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                    <StackPanel>
                        <Grid Margin="2,0,2,7">
                            <TextBlock x:Name="ShelfDockHeaderText" Text="跨屏传输架" Foreground="#E5E5EA" FontSize="11.5" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding [OverlayDockHint], Source={x:Static local:AppLoc.Shared}}" Foreground="#8E8E93" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <ScrollViewer MaxHeight="310" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="EdgeShelfList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#26282E" BorderBrush="{Binding BorderAccentBrush}" BorderThickness="1" CornerRadius="9" Padding="9" Margin="0,0,0,6">
                                            <StackPanel>
                                                <Border Background="Transparent" Cursor="SizeAll" Tag="{Binding}"
                                                        PreviewMouseLeftButtonDown="ShelfCard_MouseDown"
                                                        PreviewMouseMove="ShelfCard_MouseMove">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding SubtitleText}" Foreground="{Binding SubtitleBrush}" FontSize="10.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>

                                                <ProgressBar Height="5" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                                                             Visibility="{Binding ProgressVisibility}" Margin="0,6,0,0"
                                                             Background="#18191D" Foreground="#0A84FF" BorderThickness="0"/>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding ActionsVisibility}" Margin="0,6,0,0">
                                                    <Button Content="{Binding [ShelfOpenBtn], Source={x:Static local:AppLoc.Shared}}" Tag="{Binding Id}" Click="ShelfOpen_Click" Visibility="{Binding IncomingActionsVisibility}"
                                                            Background="#26874A" Foreground="White" BorderThickness="0" Padding="8,2" FontSize="10.5" Margin="0,0,5,0" Cursor="Hand"/>
                                                    <Button Content="{Binding [ShelfRevealBtn], Source={x:Static local:AppLoc.Shared}}" Tag="{Binding Id}" Click="ShelfReveal_Click" Visibility="{Binding IncomingActionsVisibility}"
                                                            Background="#383A42" Foreground="White" BorderThickness="0" Padding="8,2" FontSize="10.5" Margin="0,0,5,0" Cursor="Hand"/>
                                                    <Button Content="{Binding [ShelfRetryBtn], Source={x:Static local:AppLoc.Shared}}" Tag="{Binding Id}" Click="ShelfRetry_Click" Visibility="{Binding RetryVisibility}"
                                                            Background="#0A84FF" Foreground="White" BorderThickness="0" Padding="8,2" FontSize="10.5" Margin="0,0,5,0" Cursor="Hand"/>
                                                    <Button Content="{Binding [ShelfRemoveBtn], Source={x:Static local:AppLoc.Shared}}" Tag="{Binding Id}" Click="ShelfRemove_Click"
                                                            Background="#383A42" Foreground="#D1D1D6" BorderThickness="0" Padding="8,2" FontSize="10.5" Cursor="Hand"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Mode 2: Customizable Screen-Edge Mini Drop Cube -->
        <StackPanel x:Name="MiniCubeRoot" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#01000000">
            <Border Background="#EB1C1C1E" CornerRadius="6" Padding="8,3" Margin="0,0,0,5" Cursor="SizeAll"
                    MouseLeftButtonDown="CubeHandle_MouseLeftButtonDown"
                    MouseMove="CubeHandle_MouseMove"
                    MouseLeftButtonUp="CubeHandle_MouseLeftButtonUp">
                <TextBlock x:Name="CubeHandleText" Text="按住拖动位置 (55%)" Foreground="#AEAEB2" FontSize="9" HorizontalAlignment="Center"/>
            </Border>

            <Border x:Name="CubeBorder" Width="136" Height="110" CornerRadius="12" Background="#F21E1E22" BorderBrush="#0A84FF" BorderThickness="1.3" Cursor="SizeAll"
                    MouseLeftButtonDown="CubeHandle_MouseLeftButtonDown"
                    MouseMove="CubeHandle_MouseMove"
                    MouseLeftButtonUp="CubeHandle_MouseLeftButtonUp">
                <Grid ClipToBounds="True">
                    <Rectangle x:Name="CubeFillRect" VerticalAlignment="Bottom" Height="0" Fill="#380A84FF"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8">
                        <TextBlock x:Name="CubeTitleText" Text="悬浮按钮" Foreground="White" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="118"/>
                        <TextBlock x:Name="CubeSubText" Text="拖到这里，松手发送" Foreground="#98989D" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        <StackPanel x:Name="CubeActionButtons" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0" Visibility="Collapsed">
                            <Button Content="{Binding [ShelfOpenBtn], Source={x:Static local:AppLoc.Shared}}" Click="OpenReceived_Click" Background="#0A84FF" Foreground="White" BorderThickness="0" Padding="7,2" FontSize="9.5" Margin="0,0,5,0" Cursor="Hand"/>
                            <Button Content="×" Click="Dismiss_Click" Background="#3A3A3C" Foreground="White" BorderThickness="0" Padding="7,2" FontSize="9.5" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Window>
