<Window x:Class="MacBridgeUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MacBridgeUI"
        Title="OmniFlow"
        Width="980" Height="660"
        MinWidth="880" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeep}"
        Foreground="#F2F2F7"
        TextElement.Foreground="#F2F2F7"
        FontFamily="Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        PreviewDragEnter="DropZone_DragOver"
        PreviewDragOver="DropZone_DragOver"
        PreviewDragLeave="DropZone_DragLeave"
        PreviewDrop="DropZone_Drop"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="SidebarNavBtnStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D4D4DC"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="active">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Tag" Value="{x:Null}"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="NavBd" Property="Background" Value="#2A2A2F"/>
                                <Setter Property="Foreground" Value="#F2F2F7"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarSubTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9E9EA8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="active">
                    <Setter Property="Foreground" Value="#DCEBFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="215"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left macOS System Settings Style Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}" Padding="14,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App Header & Online Status + Language Pill -->
                <StackPanel Grid.Row="0" Margin="6,4,6,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="OmniFlow" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="#252528" BorderBrush="#38383C" BorderThickness="1" CornerRadius="6" Padding="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="LangZhBtn" Content="中" Click="LangZh_Click" FocusVisualStyle="{x:Null}" Cursor="Hand"
                                        BorderThickness="0" Padding="7,2" Background="#0A84FF" Foreground="White" FontSize="10" FontWeight="Bold">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="LangEnBtn" Content="EN" Click="LangEn_Click" FocusVisualStyle="{x:Null}" Cursor="Hand"
                                        BorderThickness="0" Padding="7,2" Background="Transparent" Foreground="#A6A6AE" FontSize="10" FontWeight="Medium">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Ellipse x:Name="ConnDot" Width="7" Height="7" Fill="#636366" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock x:Name="ConnStatusText" Text="等待对端连接" Foreground="{StaticResource TextDim}" FontSize="11" FontWeight="Medium"/>
                    </StackPanel>
                </StackPanel>

                <!-- 5 Navigation Items matching macOS OmniFlowMainView -->
                <StackPanel Grid.Row="1">
                    <!-- 1. Displays: SF display.2 -->
                    <Button x:Name="NavDisplaysBtn" Click="NavDisplays_Click" Background="#0A84FF" Tag="active" Style="{StaticResource SidebarNavBtnStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M8,6.5 V5 A1.5,1.5 0 0 1 9.5,3.5 H20.5 A1.5,1.5 0 0 1 22,5 V13 A1.5,1.5 0 0 1 20.5,14.5 H18 M16.5,14.5 V17.2 M14,17.2 H19"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    <Rectangle Canvas.Left="2" Canvas.Top="7.5" Width="15" Height="10.5" RadiusX="1.8" RadiusY="1.8" Fill="Transparent"
                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.75"/>
                                    <Path Data="M9.5,18 V20.8 M6.5,20.8 H12.5"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                            <StackPanel>
                                <TextBlock Text="{Binding [NavDisplaysTitle], Source={x:Static local:AppLoc.Shared}}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding [NavDisplaysSub], Source={x:Static local:AppLoc.Shared}}" Style="{StaticResource SidebarSubTextStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- 2. Input & Keyboard: SF keyboard -->
                    <Button x:Name="NavInputBtn" Click="NavInput_Click" Style="{StaticResource SidebarNavBtnStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Canvas Width="24" Height="24">
                                    <Rectangle Canvas.Left="1.5" Canvas.Top="5.5" Width="21" Height="13" RadiusX="2.4" RadiusY="2.4" Fill="Transparent"
                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.75"/>
                                    <Path Data="M5.2,9.2 H6.6 M9.4,9.2 H10.8 M13.4,9.2 H14.8 M17.4,9.2 H18.8 M5.2,12.2 H6.8 M9.6,12.2 H11.2 M13.8,12.2 H15.4 M17.8,12.2 H18.8 M7.2,15.3 H16.8"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                            <StackPanel>
                                <TextBlock Text="{Binding [NavInputTitle], Source={x:Static local:AppLoc.Shared}}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding [NavInputSub], Source={x:Static local:AppLoc.Shared}}" Style="{StaticResource SidebarSubTextStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- 3. Portal File Transfer: SF rectangle.portrait.and.arrow.right -->
                    <Button x:Name="NavPortalBtn" Click="NavPortal_Click" Style="{StaticResource SidebarNavBtnStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M14.5,6.8 V4.8 A2.1,2.1 0 0 0 12.4,2.7 H5.6 A2.1,2.1 0 0 0 3.5,4.8 V19.2 A2.1,2.1 0 0 0 5.6,21.3 H12.4 A2.1,2.1 0 0 0 14.5,19.2 V17.2 M9.5,12 H21.2 M17.5,8.2 L21.2,12 L17.5,15.8"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                            <StackPanel>
                                <TextBlock Text="{Binding [NavPortalTitle], Source={x:Static local:AppLoc.Shared}}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding [NavPortalSub], Source={x:Static local:AppLoc.Shared}}" Style="{StaticResource SidebarSubTextStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- 4. USB-C Direct: SF cable.connector -->
                    <Button x:Name="NavUsbBtn" Click="NavUsb_Click" Style="{StaticResource SidebarNavBtnStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M9.6,5.8 V3 A1,1 0 0 1 10.6,2 H13.4 A1,1 0 0 1 14.4,3 V5.8 M11.1,3.9 H12.9"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                    <Rectangle Canvas.Left="7.6" Canvas.Top="5.8" Width="8.8" Height="7.6" RadiusX="1.8" RadiusY="1.8" Fill="Transparent"
                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.75"/>
                                    <Path Data="M10.2,13.4 V15.4 A0.8,0.8 0 0 0 11,16.2 H13 A0.8,0.8 0 0 0 13.8,15.4 V13.4 M12,16.2 V21.8"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                            <StackPanel>
                                <TextBlock Text="{Binding [NavUsbTitle], Source={x:Static local:AppLoc.Shared}}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding [NavUsbSub], Source={x:Static local:AppLoc.Shared}}" Style="{StaticResource SidebarSubTextStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- 5. Network & Channels: SF network -->
                    <Button x:Name="NavNetworkBtn" Click="NavNetwork_Click" Style="{StaticResource SidebarNavBtnStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Canvas Width="24" Height="24">
                                    <Ellipse Canvas.Left="2.5" Canvas.Top="2.5" Width="19" Height="19" Fill="Transparent"
                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.75"/>
                                    <Ellipse Canvas.Left="8.2" Canvas.Top="2.5" Width="7.6" Height="19" Fill="Transparent"
                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/>
                                    <Path Data="M2.8,12 H21.2 M4.2,7.6 Q12,9.3 19.8,7.6 M4.2,16.4 Q12,14.7 19.8,16.4"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                            <StackPanel>
                                <TextBlock Text="{Binding [NavNetworkTitle], Source={x:Static local:AppLoc.Shared}}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding [NavNetworkSub], Source={x:Static local:AppLoc.Shared}}" Style="{StaticResource SidebarSubTextStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Bottom Focus & Route Box + Clickable GitHub Attribution -->
                <StackPanel Grid.Row="2">
                    <Border Background="#242427" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{Binding [SidebarHostPrefix], Source={x:Static local:AppLoc.Shared}}" Foreground="#98989D" FontSize="11.5"/>
                                <TextBlock x:Name="SidebarFocusText" Text="Windows" Foreground="#30D158" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="ControlRouteText" Text="控制连接：待连接" Foreground="#AEAEB2" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="DataRouteText" Text="文件连接：待连接" Foreground="#8E8E93" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <Button Click="OpenGitHubProfile_Click" Cursor="Hand" FocusVisualStyle="{x:Null}" BorderThickness="0" Padding="10,7" ToolTip="https://github.com/KSLengYu">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="GhBd" Background="#202024" BorderBrush="#333339" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Width="17" Height="17" Stretch="Uniform" Fill="White" VerticalAlignment="Center" Margin="0,0,8,0"
                                              Data="M12,0.5 C5.65,0.5 0.5,5.65 0.5,12 C0.5,17.08 3.79,21.39 8.36,22.91 C8.94,23.02 9.15,22.66 9.15,22.35 L9.15,20.38 C5.95,21.08 5.28,18.84 5.28,18.84 C4.76,17.52 4.01,17.16 4.01,17.16 C2.97,16.45 4.09,16.46 4.09,16.46 C5.24,16.54 5.85,17.64 5.85,17.64 C6.87,19.4 8.53,18.89 9.19,18.6 C9.29,17.85 9.59,17.35 9.92,17.06 C7.36,16.77 4.68,15.78 4.68,11.38 C4.68,10.13 5.13,9.1 5.86,8.3 C5.74,8.01 5.35,6.83 5.97,5.24 C5.97,5.24 6.93,4.93 9.13,6.42 C10.05,6.16 11.03,6.04 12,6.03 C12.97,6.04 13.95,6.16 14.87,6.42 C17.07,4.93 18.03,5.24 18.03,5.24 C18.65,6.83 18.26,8.01 18.14,8.3 C18.87,9.1 19.32,10.13 19.32,11.38 C19.32,15.79 16.63,16.76 14.07,17.05 C14.48,17.41 14.85,18.11 14.85,19.19 L14.85,22.35 C14.85,22.66 15.06,23.02 15.65,22.91 C20.21,21.39 23.5,17.08 23.5,12 C23.5,5.65 18.35,0.5 12,0.5 Z"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding GitHubDisplayName, Source={x:Static local:AppLoc.Shared}}" Foreground="White" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding GitHubHandle, Source={x:Static local:AppLoc.Shared}}" Foreground="#64D2FF" FontFamily="Consolas" FontSize="10"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="↗" Foreground="#98989D" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="GhBd" Property="Background" Value="#2B2B32"/>
                                        <Setter TargetName="GhBd" Property="BorderBrush" Value="#64D2FF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="#323236"/>

        <!-- Right Dedicated Content Area -->
        <Grid Grid.Column="2" Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Mutual TLS Pairing Confirmation Banner -->
            <Border x:Name="PairingBanner" Grid.Row="0" Visibility="Collapsed"
                    Background="#280A84FF" BorderBrush="#64D2FF" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock x:Name="PairingTitleText" Text="有设备请求配对" Foreground="White" FontSize="13" FontWeight="Bold"/>
                        <TextBlock x:Name="PairingDetailText" Text="" Foreground="#E5E5EA" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding [RejectBtn], Source={x:Static local:AppLoc.Shared}}" Click="RejectPairing_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"/>
                        <Button Content="{Binding [ConfirmPairBtn], Source={x:Static local:AppLoc.Shared}}" Click="ConfirmPairing_Click" Style="{StaticResource PrimaryBtn}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <!-- PAGE 1: 2D Spatial Arrange Displays (matching macOS ArrangeDisplaysPageView) -->
                <Grid x:Name="PageDisplays" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="{Binding [Page1Title], Source={x:Static local:AppLoc.Shared}}" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding [Page1Sub], Source={x:Static local:AppLoc.Shared}}"
                                       Foreground="#A6A6AE" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="DisplaySaveBadge" Visibility="Collapsed" Background="#2830D158" CornerRadius="6" Padding="9,5" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock x:Name="DisplaySaveBadgeText" Text="已保存位置" Foreground="#30D158" FontSize="11.5" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                            </Border>
                            <Button Content="{Binding [SaveLayoutBtn], Source={x:Static local:AppLoc.Shared}}" Click="SaveMonitors_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"/>
                            <Button Content="{Binding [IdentifyBtn], Source={x:Static local:AppLoc.Shared}}" Click="IdentifyScreens_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"/>
                            <Button Content="{Binding [ResetLayoutBtn], Source={x:Static local:AppLoc.Shared}}" Click="ResetMonitors_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"/>
                            <Button Content="{Binding [RefreshLayoutBtn], Source={x:Static local:AppLoc.Shared}}" Click="RefreshMonitors_Click" Style="{StaticResource PrimaryBtn}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 2D Interactive Spatial Canvas -->
                    <Border Grid.Row="1" Background="#252628" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                        <Canvas x:Name="ArrangeCanvas" Background="#01000000" SizeChanged="ArrangeCanvas_SizeChanged"
                                MouseMove="ArrangeCanvas_MouseMove" MouseLeftButtonUp="ArrangeCanvas_MouseLeftButtonUp"/>
                    </Border>

                    <!-- Selected Monitor Inspector Footer (matching macOS 2-line + color bar inspector) -->
                    <Border Grid.Row="2" Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="9" Padding="14,12" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SelectedMonitorBar" Grid.Column="0" Width="8" Height="24" CornerRadius="4" Background="#30D158" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="SelectedMonitorTitle" Text="Windows 显示器" Foreground="White" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SelectedMonitorText" Text="1920 × 1080 · 缩放 100% · 位置 (100, 100)" Foreground="#A6A6AE" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding [SnapHint], Source={x:Static local:AppLoc.Shared}}"
                                       Foreground="#8E8E93" FontSize="11.5" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- PAGE 2: Input, Focus Switching & Shortcuts (matching macOS InputAndShortcutsPageView) -->
                <ScrollViewer x:Name="PageInput" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding [Page2Title], Source={x:Static local:AppLoc.Shared}}" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding [Page2Sub], Source={x:Static local:AppLoc.Shared}}"
                                   Foreground="#A6A6AE" FontSize="12.5" Margin="0,4,0,18"/>

                        <!-- Card 1: Focus Switching Settings -->
                        <Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding [FocusSectionTitle], Source={x:Static local:AppLoc.Shared}}" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button x:Name="FocusToggleBtn" Grid.Column="1" Content="切到 Mac 控制" Click="ToggleManualFocus_Click" Style="{StaticResource PrimaryBtn}"/>
                                </Grid>

                                <Border Height="1" Background="#3A3A3E" Margin="0,0,0,12"/>

                                <!-- Row 1: KVM Toggle -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding [EnableKvmTitle], Source={x:Static local:AppLoc.Shared}}" Foreground="White" FontSize="13" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding [EnableKvmSub], Source={x:Static local:AppLoc.Shared}}" Foreground="#A6A6AE" FontSize="11.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="KvmToggle" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                </Grid>

                                <!-- Row 2: Edge Switch Toggle -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding [EnableEdgeTitle], Source={x:Static local:AppLoc.Shared}}" Foreground="White" FontSize="13" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding [EnableEdgeSub], Source={x:Static local:AppLoc.Shared}}" Foreground="#A6A6AE" FontSize="11.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="EdgeSwitchToggle" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                </Grid>

                                <!-- Row 3: Hotkey Switch Toggle -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding [EnableHotkeyTitle], Source={x:Static local:AppLoc.Shared}}" Foreground="White" FontSize="13" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding [EnableHotkeySub], Source={x:Static local:AppLoc.Shared}}" Foreground="#A6A6AE" FontSize="11.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="HotkeySwitchToggle" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                </Grid>

                                <!-- Row 4: Clipboard Sync Toggle -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding [EnableClipTitle], Source={x:Static local:AppLoc.Shared}}" Foreground="White" FontSize="13" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding [EnableClipSub], Source={x:Static local:AppLoc.Shared}}" Foreground="#A6A6AE" FontSize="11.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ClipToggle" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                </Grid>

                                <Border Height="1" Background="#3A3A3E" Margin="0,0,0,12"/>

                                <TextBlock Text="{Binding [CtrlDirTitle], Source={x:Static local:AppLoc.Shared}}" Foreground="White" FontSize="12.5" FontWeight="Medium" Margin="0,0,0,6"/>
                                <WrapPanel Margin="0,0,0,12">
                                    <RadioButton x:Name="CtrlDualRadio" GroupName="WinCtrlMode" Content="{Binding [CtrlDual], Source={x:Static local:AppLoc.Shared}}" IsChecked="True" FontSize="12" Margin="0,0,8,0" Checked="Setting_Changed"/>
                                    <RadioButton x:Name="CtrlMacRadio" GroupName="WinCtrlMode" Content="{Binding [CtrlMacOnly], Source={x:Static local:AppLoc.Shared}}" FontSize="12" Margin="0,0,8,0" Checked="Setting_Changed"/>
                                    <RadioButton x:Name="CtrlWinRadio" GroupName="WinCtrlMode" Content="{Binding [CtrlWinOnly], Source={x:Static local:AppLoc.Shared}}" FontSize="12" Checked="Setting_Changed"/>
                                </WrapPanel>

                                <TextBlock Text="{Binding [ModMapTitle], Source={x:Static local:AppLoc.Shared}}" Foreground="White" FontSize="12.5" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding [ModMapSub], Source={x:Static local:AppLoc.Shared}}"
                                           Foreground="#A6A6AE" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Cross-OS Semantic Shortcut Rules & Trackpad Gestures -->
                        <Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding [ShortcutsCardTitle], Source={x:Static local:AppLoc.Shared}}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding [ShortcutsCardSub], Source={x:Static local:AppLoc.Shared}}"
                                                   Foreground="#A6A6AE" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border x:Name="SettingsSaveBadge" Visibility="Collapsed" Background="#2830D158" CornerRadius="6" Padding="9,5" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="SettingsSaveBadgeText" Text="已保存设置" Foreground="#30D158" FontSize="11.5" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                                        </Border>
                                        <Button Content="{Binding [TestShotBtn], Source={x:Static local:AppLoc.Shared}}" Click="TestWinScreenshot_Click"
                                                Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"/>
                                        <Button Content="{Binding [SaveSettingsBtn], Source={x:Static local:AppLoc.Shared}}" Click="SaveInputSettings_Click"
                                                Style="{StaticResource PrimaryBtn}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Merged Dual Direction Segmented Switch (Mac -> Win | Win -> Mac) -->
                                <Border Background="#1E1F22" BorderBrush="#46464C" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14" ClipToBounds="True" SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="DirMacToWinBtn" Grid.Column="0" Content="Mac 控制 Windows（Mac → Win）"
                                                Click="DirTabMacToWin_Click" FocusVisualStyle="{x:Null}" Cursor="Hand"
                                                BorderThickness="0" Padding="10,9" Background="#0A84FF" Foreground="White" FontSize="12.5" FontWeight="SemiBold">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="7,0,0,7">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Border Grid.Column="1" Background="#46464C"/>
                                        <Button x:Name="DirWinToMacBtn" Grid.Column="2" Content="Windows 控制 Mac（Win → Mac）"
                                                Click="DirTabWinToMac_Click" FocusVisualStyle="{x:Null}" Cursor="Hand"
                                                BorderThickness="0" Padding="10,9" Background="#1E1F22" Foreground="#C8C8CE" FontSize="12.5" FontWeight="Medium">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="0,7,7,0">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>

                                <TextBlock Text="{Binding [ShortcutListTitle], Source={x:Static local:AppLoc.Shared}}" Foreground="#B2B2B8" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>

                                <ItemsControl x:Name="ShortcutRulesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="210"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}" Tag="{Binding Id}" Click="HotkeyRuleToggle_Click" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TitleDisplay}" Foreground="White" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="#29292D" CornerRadius="5" Padding="8,3">
                                                        <TextBlock Text="{Binding TriggerDisplay}" Foreground="#E5E5EA" FontSize="11.5"/>
                                                    </Border>
                                                    <TextBlock Text=" → " Foreground="#8E8E93" VerticalAlignment="Center" Margin="8,0"/>
                                                    <Border Background="#29292D" CornerRadius="5" Padding="8,3">
                                                        <TextBlock Text="{Binding ActionDisplay}" Foreground="#64D2FF" FontSize="11.5"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Height="1" Background="#3A3A3E" Margin="0,12,0,12"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock x:Name="GestureSectionTitle" Text="触控板三指拖移（MacBook 触控板 → Windows）" Foreground="#B2B2B8" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border x:Name="HighLatencyDragBadge" Visibility="Collapsed" Background="#28FF9F0A" BorderBrush="#75FF9F0A" BorderThickness="1" CornerRadius="9" Padding="7,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="HighLatencyDragBadgeText" Text="当前延迟偏高 (18 ms)" Foreground="#FF9F0A" FontSize="10.5" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>

                                <ItemsControl x:Name="GestureRulesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="210"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}" Tag="{Binding Id}" Click="HotkeyRuleToggle_Click" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TitleDisplay}" Foreground="White" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="#29292D" CornerRadius="5" Padding="8,3">
                                                        <TextBlock Text="{Binding TriggerDisplay}" Foreground="#E5E5EA" FontSize="11.5"/>
                                                    </Border>
                                                    <TextBlock Text=" → " Foreground="#8E8E93" VerticalAlignment="Center" Margin="8,0"/>
                                                    <Border Background="#29292D" CornerRadius="5" Padding="8,3">
                                                        <TextBlock Text="{Binding ActionDisplay}" Foreground="#30D158" FontSize="11.5"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Background="#18FF9F0A" BorderBrush="#45FF9F0A" BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="0,8,0,0">
                                    <TextBlock Foreground="#D6D6DC" FontSize="11" TextWrapping="Wrap" LineHeight="16"
                                               Text="{Binding [ThreeFingerWarn], Source={x:Static local:AppLoc.Shared}}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- PAGE 3: Screen-Edge Portal & File Transfer (matching macOS PortalAndFilesPageView) -->
                <ScrollViewer x:Name="PagePortal" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding [Page3Title], Source={x:Static local:AppLoc.Shared}}" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding [Page3Sub], Source={x:Static local:AppLoc.Shared}}"
                                   Foreground="#A6A6AE" FontSize="12.5" Margin="0,4,0,18"/>

                        <!-- Section 1: Edge Portal Configuration -->
                        <Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding [EnableOverlayTitle], Source={x:Static local:AppLoc.Shared}}" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="OverlayToggle" Grid.Column="1" IsChecked="True" VerticalAlignment="Center" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                </Grid>

                                <Border Height="1" Background="#3A3A3E" Margin="0,0,0,12"/>

                                <WrapPanel Margin="0,0,0,12">
                                    <StackPanel Margin="0,0,28,8">
                                        <TextBlock Text="{Binding [PortalStyleTitle], Source={x:Static local:AppLoc.Shared}}" Foreground="#C4C4CA" FontSize="12" FontWeight="Medium" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="StyleBlackHoleRadio" GroupName="WinPortalStyle" Content="{Binding [StyleHidden], Source={x:Static local:AppLoc.Shared}}" IsChecked="True" FontSize="12" Margin="0,0,6,0" Checked="Setting_Changed"/>
                                            <RadioButton x:Name="StyleCubeRadio" GroupName="WinPortalStyle" Content="{Binding [StyleCube], Source={x:Static local:AppLoc.Shared}}" FontSize="12" Checked="Setting_Changed"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock x:Name="PortalEdgeSyncHint" Text="屏幕边缘 · 屏幕 #1" Foreground="#C4C4CA" FontSize="12" FontWeight="Medium" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="EdgeRightRadio" GroupName="WinPortalEdge" Content="{Binding [EdgeRight], Source={x:Static local:AppLoc.Shared}}" FontSize="12" Margin="0,0,6,0" Checked="Setting_Changed"/>
                                            <RadioButton x:Name="EdgeLeftRadio" GroupName="WinPortalEdge" Content="{Binding [EdgeLeft], Source={x:Static local:AppLoc.Shared}}" IsChecked="True" FontSize="12" Margin="0,0,6,0" Checked="Setting_Changed"/>
                                            <RadioButton x:Name="EdgeTopRadio" GroupName="WinPortalEdge" Content="{Binding [EdgeTop], Source={x:Static local:AppLoc.Shared}}" FontSize="12" Margin="0,0,6,0" Checked="Setting_Changed"/>
                                            <RadioButton x:Name="EdgeBottomRadio" GroupName="WinPortalEdge" Content="{Binding [EdgeBottom], Source={x:Static local:AppLoc.Shared}}" FontSize="12" Checked="Setting_Changed"/>
                                        </StackPanel>
                                    </StackPanel>
                                </WrapPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="165"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="PortalOffsetText" Grid.Column="0" Text="边缘位置（55%）" Foreground="#C4C4CA" FontSize="12" VerticalAlignment="Center"/>
                                    <Slider x:Name="PortalOffsetSlider" Grid.Column="1" Minimum="0.05" Maximum="0.95" Value="0.55" VerticalAlignment="Center" ValueChanged="PortalOffsetSlider_ValueChanged"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Section 2: Direct Drag-and-Drop Box -->
                        <Border x:Name="DropZoneBorder" Background="#232427" BorderBrush="#48484D" BorderThickness="1.5" CornerRadius="10" Padding="20" Margin="0,0,0,16"
                                AllowDrop="True" PreviewDragEnter="DropZone_DragOver" PreviewDragOver="DropZone_DragOver" PreviewDragLeave="DropZone_DragLeave" PreviewDrop="DropZone_Drop"
                                DragEnter="DropZone_DragOver" DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave" Drop="DropZone_Drop">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding [DropBoxTitle], Source={x:Static local:AppLoc.Shared}}"
                                           Foreground="White" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding [DropBoxSub], Source={x:Static local:AppLoc.Shared}}"
                                           Foreground="#A6A6AE" FontSize="11.5" HorizontalAlignment="Center" Margin="0,5,0,12"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="{Binding [PickFileBtn], Source={x:Static local:AppLoc.Shared}}" Click="PickFileToSend_Click" Style="{StaticResource PrimaryBtn}" Margin="0,0,10,0"/>
                                    <Button Content="{Binding [PickFolderBtn], Source={x:Static local:AppLoc.Shared}}" Click="PickFolderToSend_Click" Style="{StaticResource SecondaryBtn}"/>
                                </StackPanel>
                                <TextBlock x:Name="LastTransferSummaryText" Text="" Foreground="#30D158" FontSize="12" HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Section 2.5: Persistent Transfer Shelf Tasks (Synced with Edge Shelf) -->
                        <Border x:Name="ShelfTasksCard" Visibility="Collapsed" Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock x:Name="ShelfTasksHeaderText" Text="传输任务（0）" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding [ShelfDragHint], Source={x:Static local:AppLoc.Shared}}" Foreground="#8E8E93" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Border Height="1" Background="#3A3A3E" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="ShelfTasksList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#202126" BorderBrush="{Binding BorderAccentBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Background="Transparent" Cursor="SizeAll" Tag="{Binding}"
                                                                PreviewMouseLeftButtonDown="MainShelfCard_MouseDown"
                                                                PreviewMouseMove="MainShelfCard_MouseMove">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}" Foreground="White" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding SubtitleText}" Foreground="{Binding SubtitleBrush}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding ActionsVisibility}">
                                                            <Button Content="{Binding [ShelfOpenBtn], Source={x:Static local:AppLoc.Shared}}" Tag="{Binding Id}" Click="MainShelfOpen_Click" Visibility="{Binding IncomingActionsVisibility}" Style="{StaticResource SecondaryBtn}" Margin="0,0,6,0"/>
                                                            <Button Content="{Binding [ShelfRevealBtn], Source={x:Static local:AppLoc.Shared}}" Tag="{Binding Id}" Click="MainShelfReveal_Click" Visibility="{Binding IncomingActionsVisibility}" Style="{StaticResource SecondaryBtn}" Margin="0,0,6,0"/>
                                                            <Button Content="{Binding [ShelfRetryBtn], Source={x:Static local:AppLoc.Shared}}" Tag="{Binding Id}" Click="MainShelfRetry_Click" Visibility="{Binding RetryVisibility}" Style="{StaticResource PrimaryBtn}" Margin="0,0,6,0"/>
                                                            <Button Content="{Binding [ShelfRemoveBtn], Source={x:Static local:AppLoc.Shared}}" Tag="{Binding Id}" Click="MainShelfRemove_Click" Style="{StaticResource SecondaryBtn}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <ProgressBar Height="5" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                                                                 Visibility="{Binding ProgressVisibility}" Margin="0,7,0,0"
                                                                 Background="#18191D" Foreground="#0A84FF" BorderThickness="0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Section 3: Received Files & ZIPs History -->
                        <Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding [ReceivedTitle], Source={x:Static local:AppLoc.Shared}}" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="{Binding [OpenFolderBtn], Source={x:Static local:AppLoc.Shared}}" Click="OpenDownloadsFolder_Click" Style="{StaticResource SecondaryBtn}"/>
                                </Grid>

                                <Border Height="1" Background="#3A3A3E" Margin="0,0,0,8"/>

                                <TextBlock x:Name="EmptyReceivedHintText" Text="{Binding [EmptyReceivedHint], Source={x:Static local:AppLoc.Shared}}"
                                           Foreground="#8E8E93" FontSize="12" Margin="0,6,0,6"/>

                                <ItemsControl x:Name="ReceivedFilesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#2E2E32" CornerRadius="4" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TypeBadge}" Foreground="#64D2FF" FontSize="10.5" FontWeight="SemiBold"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding FileName}" Foreground="White" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding FileSize}" Foreground="#A6A6AE" FontSize="12" Margin="12,0,12,0" VerticalAlignment="Center"/>
                                                <Button Grid.Column="3" Content="{Binding [ShowInFolderBtn], Source={x:Static local:AppLoc.Shared}}" Tag="{Binding SavedPath}" Click="RevealReceivedFile_Click" Style="{StaticResource SecondaryBtn}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- PAGE 4: Dedicated MacBridge USB Direct Tunnel Page (matching macOS UsbDirectPageView) -->
                <ScrollViewer x:Name="PageUsb" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding [Page4Title], Source={x:Static local:AppLoc.Shared}}" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding [Page4Sub], Source={x:Static local:AppLoc.Shared}}"
                                   Foreground="#A6A6AE" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,18"/>

                        <!-- Hero Status Card modeled directly after MacBridge -->
                        <Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse x:Name="UsbHeroDot" Grid.Column="0" Width="14" Height="14" Fill="#636366" VerticalAlignment="Center" Margin="0,0,14,0"/>

                                    <StackPanel Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="UsbHeadlineText" Text="还没连上" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="UsbSublineText" Text="连接 USB-C 线后，点击“启动 USB 直连”。"
                                                   Foreground="#A6A6AE" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Button x:Name="UsbConnectBtn" Content="{Binding [UsbConnectBtn], Source={x:Static local:AppLoc.Shared}}" Click="UsbConnect_Click" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,4"/>
                                        <Button x:Name="UsbDisconnectBtn" Content="{Binding [UsbDisconnectBtn], Source={x:Static local:AppLoc.Shared}}" Click="UsbDisconnect_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,4" Visibility="Collapsed"/>
                                        <Button x:Name="UsbRestoreBtn" Content="{Binding [UsbRestoreBtn], Source={x:Static local:AppLoc.Shared}}" Click="RestoreAppleDriver_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,0,4"/>
                                    </WrapPanel>
                                </Grid>

                                <StackPanel x:Name="UsbActionProgressPanel" Visibility="Collapsed" Margin="0,14,0,0">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding [UsbProgressLabel], Source={x:Static local:AppLoc.Shared}}" Foreground="{StaticResource TextDim}" FontSize="11.5"/>
                                        <TextBlock x:Name="UsbProgressPctText" Grid.Column="1" Text="0%" Foreground="#64D2FF" FontSize="11.5" FontWeight="Bold"/>
                                    </Grid>
                                    <Border x:Name="UsbProgressTrack" Height="8" CornerRadius="4" Background="#242428" ClipToBounds="True" SizeChanged="UsbProgressTrack_SizeChanged">
                                        <Grid>
                                            <Border x:Name="UsbProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="4" ClipToBounds="True">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                        <GradientStop Color="#0A84FF" Offset="0"/>
                                                        <GradientStop Color="#64D2FF" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Rectangle Width="64" HorizontalAlignment="Left" IsHitTestVisible="False">
                                                    <Rectangle.Fill>
                                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                                                            <GradientStop Color="#68FFFFFF" Offset="0.5"/>
                                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Rectangle.Fill>
                                                    <Rectangle.RenderTransform>
                                                        <TranslateTransform x:Name="UsbProgressSheenTransform" X="-80"/>
                                                    </Rectangle.RenderTransform>
                                                </Rectangle>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="UsbProgressHintText" Text=""
                                               Foreground="{StaticResource TextDim}" FontSize="11.5" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 3 Hardware & Tunnel Telemetry Cards -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding [UsbDevCardTitle], Source={x:Static local:AppLoc.Shared}}" Foreground="#98989D" FontSize="11.5"/>
                                    <TextBlock x:Name="UsbPortCardValue" Text="未检测到 Apple USB 设备" Foreground="White" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,5,0,3"/>
                                    <TextBlock x:Name="UsbPortCardSub" Text="驱动：未绑定" Foreground="#A6A6AE" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding [UsbIpCardTitle], Source={x:Static local:AppLoc.Shared}}" Foreground="#98989D" FontSize="11.5"/>
                                    <TextBlock x:Name="UsbIpCardValue" Text="10.13.37.2 ↔ 10.13.37.1" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,3"/>
                                    <TextBlock x:Name="UsbIpCardSub" Text="USB 直连" Foreground="#A6A6AE" FontSize="11"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="13">
                                <StackPanel>
                                    <TextBlock Text="{Binding [UsbTrafficCardTitle], Source={x:Static local:AppLoc.Shared}}" Foreground="#98989D" FontSize="11.5"/>
                                    <TextBlock x:Name="UsbTrafficCardValue" Text="收 0 / 发 0" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,5,0,3"/>
                                    <TextBlock x:Name="UsbTrafficCardSub" Text="当前延迟: 还没握手" Foreground="#A6A6AE" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Dedicated USB Console Log -->
                        <Border Background="#18181A" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <TextBlock Text="{Binding [UsbLogTitle], Source={x:Static local:AppLoc.Shared}}" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBox x:Name="UsbLogBox" Height="150" Background="Transparent" Foreground="#B8B8BE" BorderThickness="0"
                                         FontFamily="Consolas" FontSize="11" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- PAGE 5: Multi-NIC Network Channels (matching macOS NetworkAndDriverPageView) -->
                <ScrollViewer x:Name="PageNetwork" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding [Page5Title], Source={x:Static local:AppLoc.Shared}}" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding [Page5Sub], Source={x:Static local:AppLoc.Shared}}"
                                   Foreground="#A6A6AE" FontSize="12.5" Margin="0,4,0,18"/>

                        <!-- Peer Connection & Multipath Bar -->
                        <Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [PeerIpLabel], Source={x:Static local:AppLoc.Shared}}" Foreground="White" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="PeerIpBox" Width="155" Height="27" VerticalContentAlignment="Center"
                                             Background="#1C1C1E" Foreground="White" BorderBrush="#48484D" Padding="8,0" Text="" ToolTip="{Binding [PeerIpTooltip], Source={x:Static local:AppLoc.Shared}}"/>
                                    <Button x:Name="PeerConnectBtn" Content="{Binding [ConnectPeerBtn], Source={x:Static local:AppLoc.Shared}}" Click="ConnectPeer_Click" Style="{StaticResource PrimaryBtn}" Margin="8,0,0,0"/>
                                    <Button x:Name="GlobalDisconnectBtn" Content="全部断开" Click="ToggleGlobalDisconnect_Click" Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0"/>
                                </WrapPanel>
                                <CheckBox x:Name="MultipathToggle" Grid.Column="1" Content="{Binding [MultipathChk], Source={x:Static local:AppLoc.Shared}}" IsChecked="True"
                                          Foreground="White" FontSize="12.5" VerticalAlignment="Center"
                                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                            </Grid>
                        </Border>

                        <!-- NIC Channels Card -->
                        <Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding [NicListTitle], Source={x:Static local:AppLoc.Shared}}" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ChannelModeSubtitle" Grid.Column="1" Text="多通道自动调度（并发聚合）" Foreground="#9E9EA6" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="#3A3A3E" Margin="0,0,0,8"/>

                                <ItemsControl x:Name="NicListControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding StatusDotBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <WrapPanel>
                                                        <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding RoleBadgeZh}" Foreground="#30D158" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding StatusSummary}" Foreground="#A6A6AE" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding RttBadgeText}" Foreground="{Binding RttTextBrush}" FontSize="12" Width="58" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <CheckBox Content="{Binding [JoinMultipath], Source={x:Static local:AppLoc.Shared}}" IsChecked="{Binding EnabledForMultipath, Mode=OneWay}" IsEnabled="{Binding IsMultipathEditable}" Tag="{Binding}" Click="NicMultipathToggle_Click" Foreground="#C8C8CE" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <Button Content="{Binding ConnectionActionText}" Tag="{Binding}" Click="NicToggleConnection_Click" MinWidth="58"
                                                            Background="{Binding ConnBtnBackground}" BorderBrush="{Binding ConnBtnBorder}" Style="{StaticResource SecondaryBtn}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Mutual TLS Certificate Trust & Pairing Store Card -->
                        <Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock x:Name="TrustedPeersStatusText" Text="已配对设备：0 台" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="LocalTlsFingerprintText" Text="本机指纹：SHA256:..." Foreground="#A6A6AE" FontSize="11.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button x:Name="ClearTrustedPeersBtn" Grid.Column="1" Content="{Binding [ClearTrustedBtn], Source={x:Static local:AppLoc.Shared}}" Click="ClearTrustedPeers_Click"
                                            Style="{StaticResource SecondaryBtn}" Visibility="Collapsed" VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock x:Name="EmptyTrustedPeersText" Text="{Binding [EmptyTrustedText], Source={x:Static local:AppLoc.Shared}}"
                                           Foreground="#8E8E93" FontSize="11.5" Margin="0,10,0,0"/>

                                <ItemsControl x:Name="TrustedPeersList" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#343438" BorderThickness="0,1,0,0" Padding="0,8,0,4" Margin="0,4,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding DisplayHostName}" Foreground="White" FontSize="12.5" FontWeight="SemiBold"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding ShortFingerprint}" Foreground="#98989D" FontFamily="Consolas" FontSize="11"/>
                                                            <TextBlock Text=" · " Foreground="#7A7A82" FontSize="11"/>
                                                            <TextBlock Text="{Binding PairedDateDisplay}" Foreground="#98989D" FontSize="11"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="{Binding [RemoveBtn], Source={x:Static local:AppLoc.Shared}}" Tag="{Binding Fingerprint}" Click="RemoveTrustedPeer_Click"
                                                            Style="{StaticResource SecondaryBtn}" Padding="10,4" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Runtime Logs Card -->
                        <Border Background="#18181A" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <TextBlock Text="{Binding [RuntimeLogTitle], Source={x:Static local:AppLoc.Shared}}" Foreground="White" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBox x:Name="LogBox" Height="110" Background="Transparent" Foreground="#AEAEB2" BorderThickness="0"
                                         FontFamily="Consolas" FontSize="10.5" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Close Confirmation Modal Overlay -->
        <Grid x:Name="ClosePromptModal" Grid.ColumnSpan="3" Background="#B8000000" Visibility="Collapsed">
            <Border Width="430" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="#262629" BorderBrush="#48484D" BorderThickness="1" CornerRadius="12" Padding="22">
                <StackPanel>
                    <TextBlock x:Name="CloseModalTitle" Text="{Binding [CloseModalTitle], Source={x:Static local:AppLoc.Shared}}" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    <TextBlock x:Name="CloseModalBody" Text="{Binding [CloseModalBody], Source={x:Static local:AppLoc.Shared}}"
                               Foreground="#E5E5EA" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,6"/>
                    <TextBlock x:Name="CloseModalHint" Text="{Binding [CloseModalHint], Source={x:Static local:AppLoc.Shared}}"
                               Foreground="#98989D" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <StackPanel x:Name="CloseModalStatusPanel" Visibility="Collapsed" Margin="0,0,0,14">
                        <ProgressBar IsIndeterminate="True" Height="5" Foreground="#0A84FF" Background="#323236" BorderThickness="0" Margin="0,0,0,8"/>
                        <TextBlock x:Name="CloseModalStatusText" Text="{Binding [CloseModalStatus], Source={x:Static local:AppLoc.Shared}}" Foreground="#64D2FF" FontSize="12" FontWeight="Medium" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel x:Name="CloseModalBtnPanel" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CloseCancelBtn" Content="{Binding [CloseCancelBtn], Source={x:Static local:AppLoc.Shared}}" Click="ModalCancel_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"/>
                        <Button x:Name="CloseMinimizeBtn" Content="{Binding [CloseMinimizeBtn], Source={x:Static local:AppLoc.Shared}}" Click="ModalMinimize_Click" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"/>
                        <Button x:Name="CloseExitBtn" Content="{Binding [CloseExitBtn], Source={x:Static local:AppLoc.Shared}}" Click="ModalExit_Click" Style="{StaticResource PrimaryBtn}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
